{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["db:generate", "^db:migrate", "^db:seed", "^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"],
      "inputs": [
        "src/**/*",
        "app/**/*",
        "styles/**/*",
        "static/**/*",
        "public/**/*",
        "*.config.js",
        "*.config.mjs",
        "*.config.ts",
        "postcss.config.js",
        "prisma/schema.prisma"
      ]
    },
    "lint": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^db:migrate", "^db:seed", "^build"],
      "cache": false
    },
    "watch": {
      "dependsOn": ["^db:migrate", "^db:seed"],
      "cache": false
    },
    "db:generate": {
      "inputs": ["src/**/*.ts", "prisma/schema.prisma"]
    },
    "db:migrate": {
      "dependsOn": ["db:generate"]
    },
    "db:seed": {
      "dependsOn": ["db:migrate"],
      "inputs": ["src/**/*.ts", "prisma/schema.prisma"]
    },
    "clean": {}
  }
}
